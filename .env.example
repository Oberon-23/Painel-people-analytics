# Conexão do aplicativo: usuário rh_app (nunca o dono do banco)
DATABASE_URL=postgres://rh_app:SENHA@HOST/BANCO?sslmode=require
# Supabase: certificado da CA (Project Settings > Database > SSL). Neon: deixe vazio
DATABASE_CA=
# Mesmo valor gravado em app_privado.config (token_secret)
TOKEN_SECRET=
# Protege a rota de atualização agendada (/api/cron)
CRON_SECRET=
